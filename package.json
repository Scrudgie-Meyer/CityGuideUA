{
  "name": "cityguide-ua",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "CityGuide UA website with GitHub checks and Railway deployment",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node server.mjs",
    "check": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=dist/vendor/** --test-coverage-exclude=tests/** tests/*.test.mjs",
    "import": "node scripts/import-cities.mjs",
    "backup": "node scripts/backup.mjs"
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "prettier": "3.9.10"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
